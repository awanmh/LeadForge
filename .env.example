# ==========================================
# LeadForge Environment Configuration Template
# Copy this file to .env and replace placeholders.
# DO NOT commit real secrets or production credentials.
# ==========================================

# --- General / Infrastructure ---
APP_ENV=development
LOG_LEVEL=info
PUBLIC_SITE_URL=http://localhost:8080
PUBLIC_PORT=8080

# --- PostgreSQL Database (Docker & Local) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_password_dev

# CMS logical database & user
CMS_DB_NAME=leadforge_cms
CMS_DB_USER=leadforge_cms_user
CMS_DB_PASSWORD=cms_secure_pass_dev_only

# App (FastAPI) logical database & user
APP_DB_NAME=leadforge_app
APP_DB_USER=leadforge_app_user
APP_DB_PASSWORD=app_secure_pass_dev_only

# --- Strapi CMS ---
CMS_HOST=0.0.0.0
CMS_PORT=1337
STRAPI_URL=http://localhost:1337
STRAPI_DATABASE_URL=postgres://leadforge_cms_user:cms_secure_pass_dev_only@localhost:5432/leadforge_cms
APP_KEYS=devKey1,devKey2,devKey3,devKey4
API_TOKEN_SALT=dev_api_token_salt_example_only
ADMIN_JWT_SECRET=dev_admin_jwt_secret_example_only
TRANSFER_TOKEN_SALT=dev_transfer_token_salt_example_only
JWT_SECRET=dev_jwt_secret_example_only
WEBHOOK_SECRET=dev_webhook_rebuild_secret_example_only
STRAPI_READ_TOKEN=dev_read_token_astro_build_only

# --- FastAPI Lead Intake Service ---
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://leadforge_app_user:app_secure_pass_dev_only@localhost:5432/leadforge_app
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=10
TRUSTED_PROXIES=127.0.0.1

# --- Astro Frontend (Build Time) ---
# Note: Never expose STRAPI_READ_TOKEN to PUBLIC_* variables
