---
import type { CaseStudyPage } from '../../lib/strapi/types';

interface Props {
  caseStudy: CaseStudyPage;
}

const { caseStudy } = Astro.props;
---

<article class="border border-ink-14 bg-paper rounded-sm p-6 sm:p-8 flex flex-col justify-between hover:border-ink-40 transition-colors group">
  <div>
    <!-- Monochrome Typographic Header / Client Label -->
    <div class="flex items-center justify-between pb-6 mb-6 border-b border-ink-8 text-xs font-mono uppercase tracking-wider text-ink-60">
      <span>{caseStudy.clientLabel}</span>
      <span>Case Study</span>
    </div>

    <!-- Title & Challenge -->
    <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-ink mb-3 group-hover:opacity-85 transition-opacity">
      <a href={`/case-studies/${caseStudy.slug}`}>
        {caseStudy.title}
      </a>
    </h3>
    <p class="text-sm sm:text-base text-ink-80 leading-relaxed mb-6">
      {caseStudy.challenge}
    </p>
  </div>

  <!-- Read Action -->
  <div class="pt-4 border-t border-ink-8 flex items-center justify-between">
    <span class="text-xs uppercase tracking-wider text-ink-60">Verified Outcomes</span>
    <a
      href={`/case-studies/${caseStudy.slug}`}
      class="inline-flex items-center text-sm font-medium text-ink group-hover:translate-x-1 transition-transform"
      aria-label={`Read case study: ${caseStudy.title}`}
    >
      <span>Read study</span>
      <span class="ml-1" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
