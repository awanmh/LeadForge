---
import SEOHead from '../components/seo/SEOHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import type { SeoMetadata, SiteSettings } from '../lib/strapi/types';
import '../styles/global.css';

interface Props {
  seo: SeoMetadata;
  settings: SiteSettings;
  canonicalUrl?: string;
  type?: 'website' | 'article';
}

const { seo, settings, canonicalUrl, type = 'website' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead seo={seo} canonicalUrl={canonicalUrl} type={type} />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink selection:bg-ink selection:text-paper">
    <!-- Accessible Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-ink text-paper text-sm font-medium rounded-sm"
    >
      Skip to content
    </a>

    <!-- Header -->
    <SiteHeader brandName={settings.brandName} />

    <!-- Main Content -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <SiteFooter settings={settings} />
  </body>
</html>
